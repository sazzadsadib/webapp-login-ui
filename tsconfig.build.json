{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist/esm",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/index.ts", "src/email.ts", "src/core.ts", "src/rest.ts", "src/server.ts", "src/supabase.ts", "src/components/**/*.tsx", "src/lib/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/app"]
}
